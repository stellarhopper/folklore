# Allow stellarhopper to restart folklore-bot service without password
stellarhopper ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart folklore-bot
stellarhopper ALL=(ALL) NOPASSWD: /usr/bin/systemctl status folklore-bot

# Allow deploy.sh to sync systemd units from the repo into /etc.
# Fully-qualified commands with no wildcards, so only these two exact unit
# files can be written, and only to their matching destinations.
stellarhopper ALL=(ALL) NOPASSWD: /usr/bin/install -m 644 -o root -g root /home/stellarhopper/folklore/deploy/folklore-bot.service /etc/systemd/system/folklore-bot.service
stellarhopper ALL=(ALL) NOPASSWD: /usr/bin/install -m 644 -o root -g root /home/stellarhopper/folklore/deploy/mqtt-deployer.service /etc/systemd/system/mqtt-deployer.service
stellarhopper ALL=(ALL) NOPASSWD: /usr/bin/systemctl daemon-reload
